{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eyelock.github.io/ynh/schema/harness.schema.json",
  "title": "YNH Harness (0.1, superseded)",
  "description": "Harness manifest for ynh 0.1, at .harness.json. Superseded by plugin.schema.json (0.2+, at .agents/harness/plugin.json; .ynh-plugin/plugin.json before 0.8, no longer read from a source tree). Validate new manifests against that. Published so existing 0.1 manifests' $schema URLs keep resolving; ynd migrate, the only command that reads a .harness.json, rewrites them to the 0.2 schema.",
  "deprecated": true,
  "type": "object",
  "required": ["name", "version"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "author": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "default_vendor": {
      "type": "string",
      "enum": ["claude", "cursor", "codex"]
    },
    "includes": { "$ref": "#/$defs/includes" },
    "delegates_to": { "$ref": "#/$defs/delegates" },
    "hooks": { "$ref": "#/$defs/hooks" },
    "mcp_servers": { "$ref": "#/$defs/mcp_servers" },
    "profiles": {
      "description": "Named configuration variants. Merge semantics: mcp_servers are deep-merged (profile keys win), hooks use per-event replace (profile event replaces default, absent events inherited). Set a server to null to remove it.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hooks": { "$ref": "#/$defs/hooks" },
          "mcp_servers": { "$ref": "#/$defs/profile_mcp_servers" }
        }
      }
    },
    "launch_focus": {
      "description": "Name of the focus a bare `ynh run` (no --focus, no prompt) wakes with: interactive, the focus prompt as the first message, the focus's profile applied. Must name a key of the harness's own focuses whose prompt is non-empty; an included harness's namespace:name focus or a delegate's focus is not allowed, and ynd validate and ynh run refuse it (use --focus namespace:name to run one). Ignored by explicit --focus runs, delegation and `ynh agent run`.",
      "type": "string",
      "minLength": 1
    },
    "focuses": {
      "description": "Named combinations of profile + prompt for repeatable AI execution.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["prompt"],
        "additionalProperties": false,
        "properties": {
          "profile": { "type": "string" },
          "prompt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "installed_from": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "hooks": {
      "type": "object",
      "propertyNames": {
        "enum": ["before_tool", "after_tool", "before_prompt", "on_stop", "on_session_start", "on_session_end"]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["command"],
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "matcher": { "type": "string" },
            "timeout": { "type": "integer", "minimum": 1, "maximum": 3600 }
          }
        }
      }
    },
    "mcp_servers": {
      "description": "MCP servers. A null entry removes a server of that name inherited from an included harness.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "url": { "type": "string" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "oneOf": [
              { "required": ["command"] },
              { "required": ["url"] }
            ]
          }
        ]
      }
    },
    "profile_mcp_servers": {
      "description": "MCP servers within a profile. Null removes an inherited server.",
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "command": { "type": "string" },
              "args": { "type": "array", "items": { "type": "string" } },
              "env": { "type": "object", "additionalProperties": { "type": "string" } },
              "url": { "type": "string" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "oneOf": [
              { "required": ["command"] },
              { "required": ["url"] }
            ]
          }
        ]
      }
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["git"],
        "additionalProperties": false,
        "properties": {
          "git": { "type": "string" },
          "ref": { "type": "string" },
          "path": { "type": "string" },
          "pick": { "type": "array", "items": { "type": "string" } },
          "as": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
          "hooks": { "type": "boolean" }
        }
      }
    },
    "delegates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["git"],
        "additionalProperties": false,
        "properties": {
          "git": { "type": "string" },
          "ref": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_type": { "type": "string", "enum": ["git", "local", "registry"] },
        "source": { "type": "string" },
        "path": { "type": "string" },
        "registry_name": { "type": "string" },
        "installed_at": { "type": "string" }
      }
    }
  }
}
